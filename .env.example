# ---------------------------------------------------------------------------
# Copy to `.env` and fill in what you need:
#   cp .env.example .env && php artisan key:generate
#
# Every value below is a SAFE PLACEHOLDER. No credential belongs in this file.
# ---------------------------------------------------------------------------

APP_NAME="Subscription Billing & Usage Metering"
APP_ENV=local
APP_KEY=
# Production: APP_DEBUG=false (never expose stack traces or SQL to clients)
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (MySQL 8) -----------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=saas_billing
DB_USERNAME=saas
DB_PASSWORD=saas_local_dev
DB_ROOT_PASSWORD=saas_local_dev_root

# --- Cache / Queue / Rate-limiting (Redis 7) --------------------------------
CACHE_STORE=redis
# sync = run queued jobs immediately (good for local dev). redis = needs `docker compose up -d queue`.
QUEUE_CONNECTION=sync
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Sanctum -----------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost:8000,localhost:5173

# --- Mail (log driver for local development) ---------------------------------
MAIL_MAILER=log

# --- Vite --------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
