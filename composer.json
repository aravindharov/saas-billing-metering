{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "arutechsolutions/saas-billing-metering",
    "description": "Multi-tenant subscription billing and usage-metering system.",
    "keywords": [
        "laravel",
        "billing",
        "usage-metering",
        "multi-tenant",
        "saas"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.17",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.12",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm ci --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "test:unit": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test --testsuite=Unit"
        ],
        "test:feature": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test --testsuite=Feature"
        ],
        "test:coverage": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php -d memory_limit=1G ./vendor/bin/phpunit --coverage-clover=coverage/logs/clover.xml"
        ],
        "analyse": [
            "@php -d memory_limit=1G ./vendor/bin/phpstan analyse --no-progress"
        ],
        "lint": [
            "@php ./vendor/bin/pint --test"
        ],
        "lint:fix": [
            "@php ./vendor/bin/pint"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdateCmd",
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.4.1"
        },
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
