{
    "name": "saas-billing-metering",
    "description": "Subscription billing and usage-metering system — frontend SPA.",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "typecheck": "vue-tsc --noEmit --project tsconfig.json",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"resources/**/*.{ts,vue,css,json}\" \"*.{ts,js,json}\"",
        "format:check": "prettier --check \"resources/**/*.{ts,vue,css,json}\" \"*.{ts,js,json}\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "axios": "^1.13.2",
        "vue": "^3.5.43",
        "vue-router": "^5.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.1.14",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/vue": "^8.1.0",
        "@types/node": "^24.7.0",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vitest/coverage-v8": "^5.0.2",
        "@vue/test-utils": "^2.5.1",
        "eslint": "^10.11.0",
        "eslint-plugin-vue": "^10.11.1",
        "globals": "^16.4.0",
        "jsdom": "^30.1.1",
        "laravel-vite-plugin": "^3.2.0",
        "prettier": "^3.9.9",
        "tailwindcss": "^4.1.14",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.71.0",
        "vite": "^8.3.1",
        "vitest": "^5.0.2",
        "vue-tsc": "^3.3.11"
    },
    "engines": {
        "node": ">=22.12.0"
    }
}
